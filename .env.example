# =============================================
#  COPY file ini jadi .env lalu isi nilainya
#  Di Railway: isi lewat Settings > Variables
# =============================================

# PostgreSQL — otomatis diisi Railway jika pakai plugin Postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Secret — buat string acak panjang, contoh: openssl rand -hex 32
JWT_SECRET=ganti_dengan_string_rahasia_panjang_minimal_32_karakter

# URL publik app kamu (setelah deploy di Railway)
BASE_URL=https://namaapp.railway.app

# SMTP untuk kirim email verifikasi
# Contoh pakai Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=app_password_gmail_kamu
# (buat App Password di: myaccount.google.com/apppasswords)

# Environment
NODE_ENV=production
